# Per-machine overrides. Copy to docker/.env (git-ignored) and adjust.
# Project defaults (view, scenario, endpoints, pins, links) live in config/bisg.conf.
# Precedence: shell environment > this file > config/bisg.conf.
# Keep this file small: only what differs on THIS workstation.

# X display the Isaac window opens on (gui view). `./bisg setup` fills it in.
DISPLAY=:1

# Uncomment to override a project default on this machine only:
#SIM_VIEW=web                 # gui | headless | web | webrtc | both | auto  (docs/remote-access.md)
#SIM_VIEW_ADDR=100.64.0.2     # address remote viewers connect to (VPN/LAN IP)
#SIM_SCENARIO=headless_fast   # file name in sim/configs/
#ROS_DOMAIN_ID=0
#DRONE_ID=1
#FCU_URL=                     # empty = derived from DRONE_ID
#GCS_URL=udp://@192.168.1.50:14550
#ISAAC_TAG=6.0.0
#PX4_TAG=v1.17.0
#PEGASUS_TAG=pr144-fcb99c0
#ZED_SDK=5.4.1
