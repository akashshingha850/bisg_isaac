# PX4 collision prevention (Position mode) fed by the ZED depth image through MAVROS obstacle/send
# (./bisg zed up (services.px4_bridge.obstacle_distance on), docs/obstacle-avoidance.md). Applied at SITL boot by the launcher (scenario `px4.params: [collision_prevention]`);
# same values on the Pixracer via scripts/push_px4_params.py or QGC. Format: NAME VALUE MAV_PARAM_TYPE (6 INT32, 9 REAL32).
# Parameter names/ranges verified against /opt/PX4-Autopilot/src/lib/collision_prevention/collisionprevention_params.c.

CP_DIST        1.5  9   # m. Minimum distance PX4 keeps to an obstacle in Position mode; <= 0 turns collision prevention off
CP_DELAY       0.4  9   # s. Sensor + actuation delay PX4 allows for when braking (default; the sim runs slower than real time)
CP_GUIDE_ANG   30.0 9   # deg. Tolerance for slipping past an obstacle instead of stopping dead (default)
CP_GO_NO_DATA  0    6   # 0 = allow flight where the map has no data (e.g. outside the camera FOV); 1 = forbid it
