  "globalVariables": {},
  "userNodes": {
    "depth-mm": {
      "name": "depth_mm",
      "sourceCode": "// ZED depth [m, 32FC1] -> millimetres [16UC1], NaN/inf -> 0\n// Lichtblick draws 32FC1 images as grey 0..1 and ignores colormap/min/max; 16UC1 images get them.\nimport { Input, Message } from \"./types\";\n\ntype Image = Message<\"sensor_msgs/msg/Image\">;\n\nexport const inputs = [\"/drone_1/zed/zed_node/depth/depth_registered\"];\nexport const output = \"/studio_script/depth_mm\";\n\nexport default function script(event: Input<\"/drone_1/zed/zed_node/depth/depth_registered\">): Image {\n  const src = event.message;\n  const dv = new DataView(src.data.buffer, src.data.byteOffset, src.data.byteLength);\n  const le = src.is_bigendian === 0;\n  const out = new Uint8Array(src.width * src.height * 2);\n  const ov = new DataView(out.buffer);\n  for (let r = 0; r < src.height; r++) {\n    for (let c = 0; c < src.width; c++) {\n      const v = dv.getFloat32(r * src.step + c * 4, le);\n      const u = Number.isFinite(v) ? Math.min(65535, Math.max(0, Math.round(v * 1000))) : 0;\n      ov.setUint16((r * src.width + c) * 2, u, true);\n    }\n  }\n  return { header: src.header, height: src.height, width: src.width, encoding: \"16UC1\", is_bigendian: 0, step: src.width * 2, data: out };\n}\n"
    },
    "confidence-u16": {
      "name": "confidence_u16",
      "sourceCode": "// ZED depth confidence [0-100, 32FC1, higher = less confident] -> x100 [16UC1]\n// Lichtblick draws 32FC1 images as grey 0..1 and ignores colormap/min/max; 16UC1 images get them.\nimport { Input, Message } from \"./types\";\n\ntype Image = Message<\"sensor_msgs/msg/Image\">;\n\nexport const inputs = [\"/drone_1/zed/zed_node/confidence/confidence_map\"];\nexport const output = \"/studio_script/confidence_u16\";\n\nexport default function script(event: Input<\"/drone_1/zed/zed_node/confidence/confidence_map\">): Image {\n  const src = event.message;\n  const dv = new DataView(src.data.buffer, src.data.byteOffset, src.data.byteLength);\n  const le = src.is_bigendian === 0;\n  const out = new Uint8Array(src.width * src.height * 2);\n  const ov = new DataView(out.buffer);\n  for (let r = 0; r < src.height; r++) {\n    for (let c = 0; c < src.width; c++) {\n      const v = dv.getFloat32(r * src.step + c * 4, le);\n      const u = Number.isFinite(v) ? Math.min(65535, Math.max(0, Math.round(v * 100))) : 0;\n      ov.setUint16((r * src.width + c) * 2, u, true);\n    }\n  }\n  return { header: src.header, height: src.height, width: src.width, encoding: \"16UC1\", is_bigendian: 0, step: src.width * 2, data: out };\n}\n"
    }
  },
