<?xml version="1.0" encoding="UTF-8" ?>
<!-- CycloneDDS profile shared by every bisg container (ADR-004).
     UDP only; multicast discovery kept for the workstation (host network).
     On the Jetson swarm (Phase 7) set Interfaces to the WiFi NIC and use the zenoh bridge. -->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default" />
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
    <!-- Receive buffer: ASK for 16 MB but set no "min" — a hard min fails domain creation when the
         host net.core.rmem_max is smaller; without one Cyclone logs "continuing with N bytes" and
         runs. The kernel caps the request at net.core.rmem_max, and at the Ubuntu default (208 KB)
         a ZED image (1280x720 rgb8 = 2.7 MB = ~42 UDP fragments) never arrives whole: camera_info
         flows, the images silently don't. Needed on every host that consumes camera topics:
           sudo sysctl -w net.core.rmem_max=16777216   (persist in /etc/sysctl.d/, docs/setup.md) -->
    <Internal>
      <SocketReceiveBufferSize max="16MB" />
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
