ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# PX4 flight logs
*.ulg
*.tlog

# Python / editors
__pycache__/
*.pyc
.venv/
.vscode/
.idea/

# Docker
docker/.env

# third-party clones (become submodules after git init)
third_party/*/

# test output
out/
